; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="pxsmith BMFont UI"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=128
window/size/viewport_height=32
window/size/window_width_override=128
window/size/window_height_override=32
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.102, 0.11, 0.173, 1)
